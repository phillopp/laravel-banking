{
    "name": "phillopp/laravel-banking",
    "description": "Laravel Package with Banking Functions",
    "type": "library",
    "version": "0.1.0",
    "autoload": {
        "psr-4": {
            "Phillopp\\LaravelBanking\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Philip Falliano",
            "email": "philip.falliano@phillopp.de"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "jschaedl/iban-validation": "^v2.7.0",
        "illuminate/contracts": "^v13.0.0",
        "illuminate/support": "^v13.0.0"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1.1.x-dev"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5.10"
    },
    "scripts": {
        "tests": "phpunit ./tests"
    }
}
